{
  "name": "music-holo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "3D全息投影音乐播放平台 - 前端（Vue3 + Vite + Element Plus + Pinia + ECharts）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode test --outDir dist-e2e",
    "test": "vitest run --environment jsdom",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort --outDir dist-e2e",
    "gen:audio": "node scripts/gen-audio.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.2",
    "echarts": "6.1.0",
    "element-plus": "^2.5.1",
    "pinia": "2.1.7",
    "vue": "3.5.43",
    "vue-router": "4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "6.0.9",
    "jsdom": "^24.1.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
